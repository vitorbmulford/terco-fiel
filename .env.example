# Public backend URL used by the browser. This is not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Canonical origin. Use the custom production domain when it is available.
SITE_URL=https://site-santoterco.vercel.app

# Keep false locally and in preview deployments. Set true only in production.
SEO_INDEXING_ENABLED=false

# Optional ownership tokens. Do not paste HTML tags, only the token value.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
